<!DOCTYPE html>
<html lang="en">
<head>
  <!-- 1. Character encoding and viewport (always first) -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <!-- <meta name="view-transition" content="same-origin" /> -->

  <!-- 2. Primary SEO -->
  <title>{{ title }} | Biblically Faithful</title>
  <meta name="description" content="{{ synopsis if synopsis else 'Biblically Faithful — Honouring the Bible, Honouring God. Articles exploring Scripture with faithfulness and integrity.' }}">
  <link rel="canonical" href="https://biblicallyfaithful.org{{ page.url }}">
  
  <!-- 3. Sitemap -->
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <!-- 4. Open Graph (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type" content="{{ 'article' if synopsis else 'website' }}">
  <meta property="og:site_name" content="Biblically Faithful">
  <meta property="og:title" content="{{ title }} | Biblically Faithful">
  <meta property="og:description" content="{{ synopsis if synopsis else 'Honouring the Bible, Honouring God. Articles exploring Scripture with faithfulness and integrity.' }}">
  <meta property="og:url" content="https://biblicallyfaithful.org{{ page.url }}">
  <meta property="og:image" content="{{ 'https://biblicallyfaithful.org' + image if image else 'https://biblicallyfaithful.org/assets/images/placeholder.svg' }}">

  <!-- 5. Twitter/X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | Biblically Faithful">
  <meta name="twitter:description" content="{{ synopsis if synopsis else 'Honouring the Bible, Honouring God. Articles exploring Scripture with faithfulness and integrity.' }}">
  <meta name="twitter:image" content="{{ 'https://biblicallyfaithful.org' + image if image else 'https://biblicallyfaithful.org/assets/images/placeholder.svg' }}">

  <!-- 6. Article specific -->
  {% if date %}
    <meta property="article:published_time" content="{{ date }}">
  {% endif %}

  <!-- 7. RSS Feed -->
  <link rel="alternate" type="application/atom+xml" title="Biblically Faithful RSS Feed" href="https://biblicallyfaithful.org/feed.xml">


  <!-- 8. Schema Markup (last, before fonts and CSS) -->
  {% if synopsis and tags %}
  <script type="application/ld+json">
  
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ title }}",
    "description": "{{ synopsis }}",
    "image": "{{ 'https://biblicallyfaithful.org' + image if image else 'https://biblicallyfaithful.org/assets/images/placeholder.svg' }}",
    "datePublished": "{{ date | isoDate }}",
    "keywords": "{{ tags | reject('equalto', 'articles') | join(', ') }}",
    "articleSection": "{{ tags | reject('equalto', 'articles') | first | title }}",
    "author": {
      "@type": "Person",
      "name": "Brian",
      "url": "https://biblicallyfaithful.org/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Biblically Faithful",
      "url": "https://biblicallyfaithful.org"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://biblicallyfaithful.org{{ page.url }}"
    }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Biblically Faithful",
    "url": "https://biblicallyfaithful.org",
    "description": "Honouring the Bible, Honouring God. Articles exploring Scripture with faithfulness and integrity."
  }
  </script>
  {% endif %}


  <!-- 9. Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">  -->


  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- 10. Stylesheet -->
  <!-- <link rel="stylesheet" href="/css/style.css" /> -->

  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/home.css">

  <link rel="stylesheet" href="/assets/css/print.css" media="print" />

  <!-- <link rel="icon" href="/favicon.svg" type="image/svg+xml"> -->
  <link rel="icon" href="/favicon.png" sizes="512x512">
  <link rel="apple-touch-icon" href="/favicon.png">

</head>
<body>
