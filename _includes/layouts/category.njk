---
layout: layouts/base.njk
---
<div class="container">
  <div class="category-header category-header--{{ collection }}">
    
    <h1>{{ title }}</h1>
  </div>

  <p class="category-count">
    {{ collections[collection].length }} article{% if collections[collection].length != 1 %}s{% endif %}
  </p>

  {% if collections[collection].length %}
    <div class="latest-grid">
      {% for post in collections[collection] %}
        <a href="{{ post.url }}" class="article-card">
          <h3>{{ post.data.title }}</h3>
          <p class="article-card__date">{{ post.date | postDate }}</p>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="category-empty">No articles in this category yet. Check back soon.</p>
  {% endif %}

  <a href="/articles/" class="button button-outline button-accent category-back-link">
    ← All articles
  </a>
</div>