---
layout: base.njk
---

<article>
  <header>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <span class="date">{{ date | postDate }}</span>
      <span class="meta-divider">·</span>
      <span class="reading-time">{{ content | readingTime }}</span>
    </div>
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
</article>