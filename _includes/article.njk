---
layout: base.njk
---

<article>
  <header>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <span class="date">{{ date | postDate }}</span>
      <span class="meta-divider">·</span>
      <span class="reading-time">{{ content | readingTime }}</span>
    </div>
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
</article>

{% set previousPost = collections.articles | previousPost(page) %}
{% set nextPost = collections.articles | nextPost(page) %}

{% if previousPost or nextPost %}
<nav class="post-nav">
  <div class="post-nav__prev">
    {% if previousPost %}
      <span class="post-nav__label">← Previous</span>
      <a href="{{ previousPost.url }}" class="post-nav__title">
        {{ previousPost.data.title }}
      </a>
    {% endif %}
  </div>
  <div class="post-nav__next">
    {% if nextPost %}
      <span class="post-nav__label">Next →</span>
      <a href="{{ nextPost.url }}" class="post-nav__title">
        {{ nextPost.data.title }}
      </a>
    {% endif %}
  </div>
</nav>
{% endif %}