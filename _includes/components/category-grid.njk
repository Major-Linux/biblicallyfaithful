<section class="category-grid section">
    <div class="container">
        {# <div class="section-heading">
            <h2>Explore Topics</h2>
            <p>Browse studies by biblical theme.</p>
        </div> #}
        <div class="category-grid__cards">
            {% for category in categories %}
                <a class="category-card category-card--{{ category.colour }}" href="/{{ category.slug }}/">
                    <div class="category-card__icon">
                        <img src="/assets/images/icons/category-{{ category.slug }}.png" alt="">
                    </div>
                    <h3>{{ category.title }}</h3>
                    <span class="button button-filled button-{{ category.colour }}">
                        Explore →
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
