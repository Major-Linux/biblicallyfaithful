<section class="hero section">
  <div class="container">
    <div class="hero__inner panel" style="background-image: url('{{ hero.image }}');">
      <div class="hero__content">
        <p class="hero__eyebrow">{{ hero.eyebrow }}</p>
        <h1>{{ hero.title }}</h1>
        <p class="hero__summary">{{ hero.summary }}</p>        
      </div>
    </div>
  </div>
</section>