<section class="biblical-church-home section">
    <div class="container">
        <div class="biblical-church-grid panel">
            <div class="biblical-church-panel">
                <h2>
                    Biblical<br>
                    Church
                </h2>
                <img
                    class="biblical-church-panel__image"
                    src="/assets/images/illustrations/people-church-illustration-500x500.png"
                    alt=""
                >
            </div>
            <div class="biblical-church-content">
                {% set latestChurchPost = collections["biblical-church"][0] %}
                <article class="church-feature">
                    <div class="feature-row">
                        <div class="icon-box">
                            <img src="/assets/images/icons/bible-icon-48x48.png" alt="">
                        </div>
                        <div>
                            <p class="feature__eyebrow">
                                Latest Biblical Church Article
                            </p>
                            {% if latestChurchPost %}
                                <h3>
                                    {{ latestChurchPost.data.title }}
                                </h3>
                                <p>
                                    {{ latestChurchPost.data.synopsis }}
                                </p>
                                <a class="button button-filled button-church" href="{{ latestChurchPost.url }}">
                                    Read Article →
                                </a>
                            {% else %}
                                <h3>No articles yet</h3>
                                <p>Check back soon for the latest Biblical Church article.</p>
                            {% endif %}
                        </div>
                    </div>
                </article>
                <article class="church-feature">
                    <div class="feature-row">
                        <div class="icon-box">
                            <img src="/assets/images/icons/people-church-icon-48x48.png" alt="">
                        </div>
                        <div>
                            <h3>
                                What is a Biblical Church?
                            </h3>                        
                            <p>
                                A guided page for new visitors, Christians seeking a
                                church, and church leaders comparing practice with
                                Scripture.
                            </p>
                            <a class="button button-filled button-church" href="/what-is-a-biblical-church/">
                                Explore →
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>