{% set latestScripture = collections["featured-scripture"][0] %}
<section class="featured-scripture section">
  <div class="container">
    <div class="featured-scripture__card panel">
      <div class="featured-scripture__reference">
        <p class="feature__eyebrow">Featured Scripture</p>
        {% if latestScripture %}
          <h2>{{ latestScripture.data.scriptureReference }}</h2>
          <a href="{{ latestScripture.url }}" class="button button-filled button-featured-scripture">
            Related Article →
          </a>
        {% else %}
          <h2>Coming Soon</h2>
        {% endif %}
      </div>
      <div class="featured-scripture__content">
        {% if latestScripture %}
          <blockquote>
            "{{ latestScripture.data.scriptureText }}"
          </blockquote>
          
            <cite>{{ latestScripture.data.scriptureReferenceShort }}</cite>  ({{ latestScripture.data.scriptureVersionAbbr }})
            
          
        {% else %}
          <p>Check back soon for a featured scripture passage.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>