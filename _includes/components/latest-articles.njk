<section class="latest-articles section">
  <div class="container">
    <div class="section-heading">
      <h2>Latest Articles</h2>
      <a href="/articles/" class="button button-outline button-accent">
        View all articles →
      </a>
    </div>

    <div class="latest-grid">
      {% for post in collections.articles %}
        {% if loop.index <= 8 %}
          {% set categoryTag = "" %}
          {% for tag in post.data.tags %}
            {% if tag != "articles" %}{% set categoryTag = tag %}{% endif %}
          {% endfor %}
          <a href="{{ post.url }}" class="article-card">
            <h3>{{ post.data.title }}</h3>
            {% if post.data.synopsis %}
              <p class="article-card__synopsis">{{ post.data.synopsis }}</p>
            {% endif %}
            <div class="article-card__meta">
              <span class="article-card__category article-card__category--{{ categoryTag }}">
                <img src="/assets/images/icons/category-{{ categoryTag }}.png" alt="">
                {{ categoryTag | replace("-", " ") | title }}
              </span>
              <span class="article-card__date">{{ post.date | postDate }}</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>